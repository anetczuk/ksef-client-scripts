#!/bin/bash

set -eu


INVOICE_PATH=""

while [[ $# -gt 0 ]]; do
    case "${1}" in
        --help|-h)
            SCRIPT_NAME=$(basename "$(readlink -f "${BASH_SOURCE[@]}")")
            echo "usage: ${SCRIPT_NAME} [--invoice|-i <path>] [--help|-h]"
            echo
            echo "Convert KSeF invoice XML to PDF. Generated file will be placed along the XML file."
            echo
            echo "options:"
            echo "  -h, --help       show this help"
            echo "  -i, --invoice    path to invoice XML file or path to directory with XMLs"
            exit 0
            ;;

        --invoice=*|-i=*)
            INVOICE_PATH="${1#*=}"
            shift
            ;;
        --invoice|-i)
            INVOICE_PATH="${2}"
            shift 2
            ;;

        *)
            echo "unknown argument: ${1}"
            exit 1
            ;;
    esac
done


SCRIPT_DIR=$(dirname "$(readlink -f "$0")")


SITE_PACKAGES=$(python3 -c "import ksefclientscripts; import os; print(os.path.dirname(ksefclientscripts.__file__))")

# shellcheck disable=SC1091
source "${SITE_PACKAGES}/config.bash"


if [[ ! -f "${PDF_GENERATOR_BIN_PATH}" ]]; then
    "${SITE_PACKAGES}"/install-pdf-converter.sh
fi


convert_xml() {
    local input_path="${1}"
    out_path="${input_path%.*}.pdf"

    (    
        set -x
        LC_ALL=pl_PL.UTF-8 "${PDF_GENERATOR_BIN_PATH}" faktura "${input_path}" "${out_path}" > /dev/null
    )
}


if [[ -f "${INVOICE_PATH}" ]]; then
    echo "converting file ${INVOICE_PATH}"
    convert_xml "${INVOICE_PATH}"
    exit 0
fi

if [[ -d "${INVOICE_PATH}" ]]; then
    for file in "${INVOICE_PATH}"/*.xml; do
        echo "converting file ${file}"
        convert_xml "${file}"
    done
    exit 0
fi

echo "unhandled case"
exit 1
