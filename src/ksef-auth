#!/bin/bash

##
## Required package: yq
##

set -eu


CONFIG_PATH=""

while [[ $# -gt 0 ]]; do
    case "${1}" in
        --help|-h)
            SCRIPT_NAME=$(basename "$(readlink -f "${BASH_SOURCE[@]}")")
            echo "usage: ${SCRIPT_NAME} [-c <path>] [--help|-h]"
            echo
            echo "authenticate to KSeF using config file"
            echo
            echo "options:"
            echo "  -h, --help      show this help"
            echo "  -c, --config    path to config toml containing env and auth method"
            exit 0
            ;;

        --config=*|-c=*)
            CONFIG_PATH="${1#*=}"
            shift
            ;;
        --config|-c)
            CONFIG_PATH="${2}"
            shift 2
            ;;

        *)
            echo "unknown argument: ${1}"
            exit 1
            ;;
    esac
done


AUTH_SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[@]}")")


SITE_PACKAGES=$(python3 -c "import ksefclientscripts; import os; print(os.path.dirname(ksefclientscripts.__file__))")

# shellcheck disable=SC1091
source "${SITE_PACKAGES}/utils.bash"


auth_log_in() {
    local context_type=$(tomlq -r '.context.type' "${toml_config_path}")
    local context_value=$(tomlq -r '.context.value' "${toml_config_path}")

    if ! ksef profile list | grep "OK (profile.list, profile=${profile_name})" > /dev/null; then
        ## profile not active
        local profile_type=$(tomlq -r '.profile.env' "${toml_config_path}")
        echo "initializing ${profile_name} environment of type ${profile_type}"
        ksef init --non-interactive --name "${profile_name}" --env "${profile_type}" --context-type "${context_type}" --context-value "${context_value}" --set-active
    fi

    local auth_type=$(tomlq -r '.auth.type' "${toml_config_path}")

    if [[ "${auth_type}" == "ENV_VAR" ]]; then
        ## authenticate using KSEF_TOKEN env var
        ksef auth login-token
        exit 0
    fi    

    if [[ "${auth_type}" == "PROMPT" ]]; then
        ## authenticate using prompt
        unset KSEF_TOKEN || true
        ksef auth login-token
        exit 0
    fi    

    local token=$(ksef-get-credentials -c "${toml_config_path}")
    if [ -z "${token}" ]; then
        echo "unable to get authentication data"
        exit 1
    fi

    ## pass through env variable for security reasons
    KSEF_TOKEN="${token}" ksef auth login-token 
}


## $1 - config path
auth_env() {
    local toml_config_path="${1}"

    auth_status_json="$(ksef --json auth status)"

    if ! is_json_ok "${auth_status_json}"; then
        ## invalid response
        echo "could not get authentication status - need authentication"
        auth_log_in
        exit 1
    fi

    local profile_name=$(tomlq -r '.profile.name' "${toml_config_path}")
    curr_profile_name=$(jq -r '.profile' <<< "${auth_status_json}")
    if [[ "${curr_profile_name}" != "${profile_name}" ]]; then
        ## profile name differs
        echo "current profile differs - need authentication"
        auth_log_in
        return 0
    fi

    access_until=$(jq -r '.data.access_valid_until' <<< "${auth_status_json}")
    ## offset "until" timestamp to make sure that next command after authorization will not exceed the limit
    access_until_timestamp=$(date -d "${access_until} -1 minute" +%s)
    current_timestamp=$(date +%s)

    if (( current_timestamp > access_until_timestamp )); then
        echo "session timeout - need authentication"
        auth_log_in
        return 0
    fi

    echo "already authenticated"
}


auth_env "${CONFIG_PATH}"
